# Copy to .env. Paths may contain spaces; use dotenv quotes.
# PAPERFLOW_DATA_DIR="/Users/you/Library/Application Support/PaperFlow"
PAPERFLOW_PORT=8000
PAPERFLOW_MARKER_EXECUTABLE=marker_single
PAPERFLOW_MARKER_TIMEOUT=1800
PAPERFLOW_MAX_UPLOAD_MB=100
# Marker dependencies/models stay in their own environment.
# LLAMA_CPP_BINARY="/opt/homebrew/bin/llama-server"
# HF_HOME="/Users/you/Library/Caches/PaperFlow/models"
# Never put Read Frog / DeepSeek keys here unless fallback has been activated.
