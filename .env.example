# Copy to .env. Paths may contain spaces; use dotenv quotes.
# PAPERFLOW_DATA_DIR="/Users/you/Library/Application Support/PaperFlow"
PAPERFLOW_PORT=8000
PAPERFLOW_MARKER_EXECUTABLE=marker_single
PAPERFLOW_MARKER_TIMEOUT=1800
PAPERFLOW_MAX_UPLOAD_MB=100
# False keeps metadata extraction local; no arXiv/Crossref enrichment.
PAPERFLOW_METADATA_ONLINE=true
# Discovery metadata fetching is independent of Library metadata enrichment.
PAPERFLOW_DISCOVERY_ONLINE=true
# Optional server-side key; Settings can instead save a local 0600 key file.
# AI calls stay disabled until explicitly enabled in Research Discovery settings.
# PAPERFLOW_DEEPSEEK_API_KEY="your-key"
# Marker dependencies/models stay in their own environment.
# LLAMA_CPP_BINARY="/opt/homebrew/bin/llama-server"
# HF_HOME="/Users/you/Library/Caches/PaperFlow/models"

# Optional peer sync: docs/PEER_SYNC.md. Keep existing local Marker settings.
PAPERFLOW_SYNC_ENABLED=false
# Same random secret (at least 32 characters) on both devices; never commit it.
# PAPERFLOW_SYNC_TOKEN=""
# Mac only: Ubuntu's HTTPS origin, without a /peer path.
# PAPERFLOW_SYNC_PEER_URL="https://ubuntu.your-tailnet.ts.net:8443"
# Ubuntu: true; Mac: false. Disable DISCOVERY_ONLINE on Ubuntu separately.
PAPERFLOW_SYNC_ACCEPT_CONVERSIONS=false
PAPERFLOW_SYNC_INTERVAL=15
